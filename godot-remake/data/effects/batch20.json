  "Inspection": {
    "fx": [
      {
        "type": "spell",
        "stay": true,
        "do": []
      },
      {
        "type": "trigger",
        "when": [
          "standby_phase",
          "inspection_again"
        ],
        "cond": [
          {
            "c": "event_by",
            "who": "opp"
          },
          {
            "c": "hand",
            "who": "opp",
            "op": ">",
            "v": 0
          },
          {
            "c": "phase",
            "is": [
              "standby"
            ]
          },
          {
            "c": "lp",
            "who": "self",
            "op": ">",
            "v": 500
          },
          {
            "c": "inspection_source"
          }
        ],
        "cost": [
          {
            "op": "pay_lp",
            "amount": 500
          }
        ],
        "do": [
          {
            "op": "select",
            "as": "peek",
            "from": "opp.hand",
            "filter": {},
            "n": 1,
            "auto": false,
            "hidden_pick": true,
            "prompt_text": "Pick 1 card from your opponent's hand."
          },
          {
            "op": "custom",
            "fn": "inspection"
          },
          {
            "op": "custom",
            "fn": "inspection_again"
          }
        ]
      }
    ]
  },
  "Scroll of Bewitchment": {
    "fx": [
      {
        "type": "equip",
        "target": [
          {
            "op": "select",
            "as": "t",
            "from": "monsters",
            "filter": {
              "face_up": true
            },
            "n": 1,
            "prompt": 241
          },
          {
            "op": "choice",
            "as": "attribute",
            "count": 6,
            "labels": [
              "LIGHT",
              "DARK",
              "WATER",
              "FIRE",
              "EARTH",
              "WIND"
            ],
            "prompt_text": "Choose an Attribute."
          }
        ],
        "do": [
          {
            "op": "equip",
            "to": "$t",
            "attribute_var": "attribute"
          }
        ]
      }
    ]
  },
  "Deepsea Warrior": {
    "fx": [
      {
        "type": "static",
        "rule": "spell_immune_umi",
        "scope": "self"
      }
    ]
  },
  "Jam Defender": {
    "fx": [
      {
        "type": "continuous_trap",
        "speed": 2,
        "stay": true,
        "when": [
          "summoned",
          "special_summoned",
          "flip_summoned",
          "attack_declared",
          "activated_spell",
          "activated_trap",
          "standby_phase",
          "end_phase",
          "target_declared"
        ],
        "do": []
      },
      {
        "type": "trigger",
        "speed": 2,
        "when": "target_declared",
        "cond": [
          {
            "c": "event_by",
            "who": "opp"
          },
          {
            "c": "event_target",
            "mine": true
          },
          {
            "c": "has",
            "zone": "self.monsters",
            "filter": {
              "name_is": "Revival Jam",
              "face_up": true,
              "not_target": true
            }
          }
        ],
        "do": [
          {
            "op": "select",
            "as": "t",
            "from": "self.monsters",
            "filter": {
              "name_is": "Revival Jam",
              "face_up": true,
              "not_target": true
            },
            "n": 1,
            "prompt": 241
          },
          {
            "op": "redirect_attack",
            "to": "$t"
          }
        ]
      }
    ]
  },
  "Manga Ryu-Ran": {
    "fx": [
      {
        "type": "static",
