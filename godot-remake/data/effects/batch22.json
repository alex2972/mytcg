   }
  ]
 },
 "Fake Trap": {
  "fx": []
 },
 "Dark Sage": {
  "fx": [
   {
    "type": "static",
    "rule": "no_normal_summon",
    "scope": "self"
   }
  ]
 },
 "Thousand-Eyes Restrict": {
  "fx": [
   {
    "type": "static",
    "rule": "no_attack",
    "scope": "all",
    "filter": {
     "not_src": true
    }
   },
   {
    "type": "static",
    "rule": "no_position_change",
    "scope": "all",
    "filter": {
     "not_src": true
    }
   },
   {
    "type": "ignition",
    "once_per_turn": true,
    "target": [
     {
      "op": "select",
      "as": "t",
      "from": "opp.monsters",
      "filter": {},
      "n": 1,
      "prompt": 99
     }
    ],
    "do": [
     {
      "op": "to_grave",
      "what": {
       "from": "self.spells",
       "filter": {
        "equipped_to_src": true
       }
      },
      "reason": "effect"
     },
     {
      "op": "become_equip",
      "card": "$t",
      "to": "src",
      "on_host_side": true,
      "take_stats": true
