    "do": [
     {
      "op": "refpanel_swap"
     }
    ],
    "cond": [
     {
      "c": "chain_top_by",
      "is": "opp"
     },
     {
      "c": "chain_top_targets_player"
     }
    ]
   }
  ]
 },
 "Fairy's Hand Mirror": {
  "fx": [
   {
    "type": "trap",
    "speed": 2,
    "when": [
     "summoned",
     "special_summoned",
     "flip_summoned",
     "attack_declared",
     "target_declared",
     "damage_step",
     "activated_spell",
     "activated_trap",
     "standby_phase",
     "end_phase"
    ],
    "do": [
     {
