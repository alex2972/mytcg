  "Blind Destruction": {
    "fx": [
      {
        "type": "continuous_trap",
        "speed": 2,
        "stay": true,
        "when": [
          "summoned",
          "special_summoned",
          "flip_summoned",
          "attack_declared",
          "activated_spell",
          "activated_trap",
          "standby_phase",
          "end_phase"
        ],
        "do": []
      },
      {
        "type": "trigger_forced",
        "when": "standby_phase",
        "cond": [
          {
            "c": "turn",
            "is": "self"
          }
        ],
        "do": [
          {
            "op": "dice",
            "as": "roll"
          },
          {
            "op": "if",
            "cond": [
              {
                "c": "var_ge",
                "name": "roll",
                "v": 6
              }
            ],
            "then": [
              {
                "op": "destroy",
                "what": {
                  "from": "monsters",
                  "filter": {
                    "face_up": true,
                    "level_min": 6
                  }
                }
              }
            ],
            "else": [
              {
                "op": "destroy",
                "what": {
                  "from": "monsters",
                  "filter": {
                    "level_eq": {
                      "var": "roll"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
