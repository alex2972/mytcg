  {"type": "trigger_forced", "when": "end_phase", "cond": [{"c": "turn", "is": "opp"}], "do": [
    {"op": "counter", "name": "turns", "add": 1},
    {"op": "if", "cond": [{"c": "counter", "name": "turns", "op": ">=", "v": 2}], "then": [{"op": "destroy", "what": "src"}]}]}]},

"Umi": {"fx": [{"type": "field", "do": []},
  {"type": "static", "mod": {"scope": "all", "filter": {"race": ["Fish", "Sea Serpent", "Thunder", "Aqua"]}, "atk": 200, "def": 200}},
  {"type": "static", "mod": {"scope": "all", "filter": {"race": ["Machine", "Pyro"]}, "atk": -200, "def": -200}}]},
"Umiiruka": {"fx": [{"type": "field", "do": []},
