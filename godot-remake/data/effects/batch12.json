{
 "_about": "Batch 12: the last cards of the preset decks that could be written with the current engine.",
 "Ekibyo Drakmord": {
  "fx": [
   {
    "type": "equip",
    "target": [
     {
      "op": "select",
      "as": "t",
      "from": "monsters",
      "filter": {
       "face_up": true
      },
      "n": 1,
      "prompt": 101
     }
    ],
    "do": [
     {
      "op": "equip",
      "to": "$t"
     }
    ]
   },
   {
    "type": "static",
    "rule": "no_attack",
    "scope": "equipped"
   },
   {
    "type": "trigger_forced",
    "when": "end_phase",
    "cond": [
     {
      "c": "turn",
      "is": "equipped_ctrl"
     },
     {
      "c": "equipped_is",
      "filter": {}
     }
    ],
    "do": [
     {
      "op": "counter",
      "name": "turns",
      "add": 1
     },
     {
      "op": "if",
      "cond": [
       {
        "c": "counter",
        "name": "turns",
        "op": ">=",
        "v": 2
       }
      ],
      "then": [
       {
        "op": "destroy",
        "what": "equipped"
       },
       {
        "op": "to_hand",
        "what": "src"
       }
      ]
     }
    ]
   }
  ]
 },
 "Exchange": {
  "fx": [
   {
    "type": "spell",
    "cond": [
     {
      "c": "hand",
      "who": "opp",
      "op": ">=",
      "v": 1
     }
    ],
    "do": [
     {
      "op": "select",
      "as": "a",
      "from": "opp.hand",
      "n": 1,
      "min": 0,
      "required": false,
      "auto": false,
      "prompt": 244
     },
     {
      "op": "select",
      "as": "b",
      "from": "self.hand",
      "n": 1,
      "min": 0,
      "required": false,
      "auto": false,
      "chooser": "opp",
      "prompt": 244
     },
     {
      "op": "take_from_hand",
      "what": "$a",
      "to": "self"
     },
     {
      "op": "take_from_hand",
      "what": "$b",
      "to": "opp"
     }
    ]
   }
  ]
 },
